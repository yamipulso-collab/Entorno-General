# Variables del .env de /root/evo-yami/app (partir del .env.example de evo-mk y cambiar estas)
EVO_ROOT=/root/evo-yami
INSTANCE=yamila                      # instancia NUEVA de Evolution, no la de la agencia
ALLOWED_NUMBERS=549XXXXXXXXXX        # ❓ el número desde el que Yamila le habla al agente
DRY_RUN=true                         # true mientras se prueba
ENABLED=false                        # true recién cuando esté probado
RUTINA_HORA=08:30
CLAUDE_CONFIG_DIR=/root/.claude-yami # login propio de Yamila (sus conectores y su cuota)
# Chatwoot y la Cola (n8n) NO se usan en esta instalación: dejar vacíos.
